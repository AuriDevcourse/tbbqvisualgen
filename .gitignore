# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# reference images
/references

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ship the env template
!.env.example
.merge-partner/

# Output of `npm run logos:dupes` — a local report, not a source file
duplicate-logos-report.json

# Logos deleted from the library via the picker (recoverable, not committed)
.logos-trash/

# Dry-run output of `node scripts/stage-new-logos.mjs` — candidates pulled off
# this machine, reviewed by hand before anything lands in public/logos
.logos-staging/
logo-staging-report.json
# Dry-run output of `npm run logos:ls-feed` — the LS x DT roster's logo
# attachments downloaded from the connector feed, kept only long enough to
# review and name before copying into public/logos
.logos-feed/
.logos-tiers/
ls-feed-sync-report.json

# Contact sheets from `node scripts/logo-contact-sheet.mjs`
*-contact-sheet.png
approved.png

# Local Claude Code state (incl. agent worktrees and their build output)
.claude/

# Finished thank-you walls handed to marketing — deliverables, not source.
exports-ls-dt/

.vercel
.env*

# One-off migration backups (contain full template docs, no secrets)
backup-templates-*.json
